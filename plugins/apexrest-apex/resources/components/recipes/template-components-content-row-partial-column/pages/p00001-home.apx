page 1 (
    name: Component Example
    alias: HOME
    title: Component Example
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
    }
    region results (
        name: Partial Column Example
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Example entry' TITLE, 'Local description' DESCRIPTION, 'component' COMPONENT from dual
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        column TITLE (
            type: plainText
            heading {
                heading: Title
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
        )
        column DESCRIPTION (
            type: plainText
            heading {
                heading: Description
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
        )
        column COMPONENT (
            type: themeTemplateComponent/contentRow
            heading {
                heading: Content Row
            }
            layout {
                sequence: 100
            }
            source {
                dataType: STRING
            }
            settings {
            title: &TITLE.
            description: &DESCRIPTION.
            }
        )
    )

)

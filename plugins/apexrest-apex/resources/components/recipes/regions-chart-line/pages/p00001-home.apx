page 1 (
    name: Component Example
    alias: HOME
    title: Component Example
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
    }
    region example (
        name: Chart
        type: chart
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        chart {
            type: line
        }
        axis x (
            name: x
        )
        axis y (
            name: y
        )
        series values (
            name: Example Values
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select 'Alpha' LABEL, 12 VALUE from dual union all select 'Beta', 7 from dual
                    ```
            }
            columnMapping {
                label: LABEL
                value: VALUE
            }
        )
    )

)

page 1 (
    name: Component Example
    alias: HOME
    title: Component Example
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
    }
    region example (
        name: Editable Grid
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: APEXREST_EXAMPLE_ROWS
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            lostUpdateType: rowVersionColumn
            rowVersionColumn: ROW_VERSION
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        column ID (
            type: hidden
            layout {
                sequence: 10
            }
            source {
                databaseColumn: ID
                dataType: number
                primaryKey: true
                queryOnly: true
            }
        )
        column NAME (
            type: textField
            heading {
                heading: Name
            }
            layout {
                sequence: 20
            }
            source {
                databaseColumn: NAME
                dataType: varchar2
            }
        )
        column STATUS (
            type: textField
            heading {
                heading: Status
            }
            layout {
                sequence: 30
            }
            source {
                databaseColumn: STATUS
                dataType: varchar2
            }
        )
        column ROW_VERSION (
            type: hidden
            layout {
                sequence: 40
            }
            source {
                databaseColumn: ROW_VERSION
                dataType: number
                queryOnly: true
            }
        )
        savedReport 1 (
            visibility: primary
            view {
                default: grid
            }
            displayColumn (
                column: @NAME
                layout {
                    sequence: 10
                }
            )
            displayColumn (
                column: @STATUS
                layout {
                    sequence: 20
                }
            )
        )
    )
    process save-grid (
        name: Save grid
        type: interactiveGridAutoRowProcessing
        editableRegion: @example
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Example rows saved.
        }
    )

)

page 1 (
    name: Component Example
    alias: HOME
    title: Component Example
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
    }
    region results (
        name: Partial Column Example
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Open tasks' TITLE, 12 METRIC, 'Synthetic example' META, 'component' COMPONENT from dual
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        column TITLE (
            type: plainText
            heading {
                heading: Title
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
        )
        column METRIC (
            type: plainText
            heading {
                heading: Metric
            }
            layout {
                sequence: 20
            }
            source {
                dataType: NUMBER
            }
        )
        column META (
            type: plainText
            heading {
                heading: Meta
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
        )
        column COMPONENT (
            type: themeTemplateComponent/metricCard
            heading {
                heading: Metric Card
            }
            layout {
                sequence: 100
            }
            source {
                dataType: STRING
            }
            settings {
            title: &TITLE.
            metric: &METRIC.
            meta: &META.
            }
        )
    )

)

page 2 (
    name: Work queue
    alias: PAGE-2
    title: Work queue
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigationMenu {
        overrideUserInterfaceLevel: true
        list: @workspace-menu
        listPosition: top
        listTemplate: @/top-navigation-mega-menu
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
    }
    region content (
        name: Work queue
        type: staticContent
        source {
            htmlCode: <p>Work queue is an original local navigation destination.</p>
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )
)

    region actions (
        name: Page navigation
        type: staticContent
        layout {
            sequence: 80
            slot: body
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--slimPadding
                t-ButtonRegion--stickToBottom
            ]
        }
    )
    button navigate (
        buttonName: NAVIGATE
        label: Back to overview
        layout {
            sequence: 10
            region: @actions
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
            }
        }
    )
)

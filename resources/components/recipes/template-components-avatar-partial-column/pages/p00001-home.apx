page 1 (
    name: Component Example
    alias: HOME
    title: Component Example
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
    }
    region results (
        name: Partial Column Example
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'EX' INITIALS, 'component' COMPONENT from dual
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        column INITIALS (
            type: plainText
            heading {
                heading: Initials
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
        )
        column COMPONENT (
            type: themeTemplateComponent/avatar
            heading {
                heading: Avatar
            }
            layout {
                sequence: 100
            }
            source {
                dataType: STRING
            }
            settings {
            type: initials
            initials: INITIALS
            }
        )
    )

)

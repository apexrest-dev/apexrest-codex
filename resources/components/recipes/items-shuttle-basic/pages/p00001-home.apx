page 1 (
    name: Component Example
    alias: HOME
    title: Component Example
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
    }
    region form (
        name: Form
        type: staticContent
        source {
            htmlCode: <p>Local component example.</p>
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )
    pageItem P1_VALUE (
        type: shuttle
        label {
            label: Shuttle
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Alpha;A,Beta;B
        }
        layout {
            sequence: 10
            region: @form
            slot: regionBody
            alignment: left
            columnSpan: 12
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 5
        }
    )

)
